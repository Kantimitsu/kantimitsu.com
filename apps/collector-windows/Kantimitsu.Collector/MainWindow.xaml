<Window x:Class="Kantimitsu.Collector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kantimitsu Benchmark Collector" Height="760" Width="1080" MinHeight="620" MinWidth="860"
        Background="#050806" Foreground="#1AFF5C" FontFamily="Consolas">
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Text="KANTIMITSU // COLLECTOR" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="0.1.0-beta · LOCAL REPORT" Foreground="{StaticResource TerminalAmber}" Margin="0,4,0,20"/>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">Choose each category deliberately. The report stays on this PC until you inspect it and save it. The collector never submits enquiries or uploads reports.</TextBlock>
      <TextBlock Text="REPORT SECTIONS" FontWeight="Bold" Margin="0,8"/>
      <CheckBox x:Name="HardwareCheck" Content="CPU, GPU and installed memory"/>
      <CheckBox x:Name="DisplaysCheck" Content="Display resolutions"/>
      <CheckBox x:Name="AudioCheck" Content="Audio device friendly names"/>
      <CheckBox x:Name="SoftwareCheck" Content="Known streaming software"/>
      <CheckBox x:Name="GameCheck" Content="Include the game name typed below"/>
      <TextBox x:Name="GameText" MaxLength="120" Background="#020403" Foreground="{StaticResource TerminalGreen}" BorderBrush="#31543B" Padding="8" Margin="0,3,0,5" ToolTip="Typed by you; the collector does not inspect the foreground process."/>
      <CheckBox x:Name="BenchmarkCheck" Content="30-second CPU / RAM sample"/>
      <CheckBox x:Name="NetworkCheck" Content="Optional kantimitsu.com wire test"/>
      <Border BorderBrush="#31543B" BorderThickness="1" Padding="12" Margin="0,18,0,0">
        <TextBlock TextWrapping="Wrap">NEVER COLLECTED: passwords, tokens, product keys, usernames, user profile paths, file lists, browser history, recordings, window titles, serial numbers, or arbitrary process lists.</TextBlock>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button x:Name="ScanButton" Click="ScanButton_Click">GENERATE</Button>
        <Button x:Name="CancelButton" Click="CancelButton_Click" IsEnabled="False">CANCEL</Button>
      </StackPanel>
      <Button x:Name="SaveButton" Click="SaveButton_Click" IsEnabled="False" Margin="0,10,0,0" HorizontalAlignment="Left">SAVE REVIEWED JSON…</Button>
      <TextBlock x:Name="StatusText" Text="Ready. Nothing has been scanned." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource TerminalAmber}"/>
    </StackPanel>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="REPORT PREVIEW — EDIT OR REMOVE ANYTHING BEFORE SAVING" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBox x:Name="PreviewText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#020403" Foreground="{StaticResource TerminalGreen}" BorderBrush="#31543B" FontFamily="Consolas" FontSize="13" Padding="12" IsReadOnly="False" SpellCheck.IsEnabled="False"/>
    </Grid>
  </Grid>
</Window>
