<Application x:Class="Kantimitsu.Collector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="TerminalGreen" Color="#1AFF5C" />
    <SolidColorBrush x:Key="TerminalAmber" Color="#FFB000" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="#050806" />
      <Setter Property="Foreground" Value="{StaticResource TerminalGreen}" />
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#102A18" />
      <Setter Property="Foreground" Value="{StaticResource TerminalGreen}" />
      <Setter Property="BorderBrush" Value="{StaticResource TerminalGreen}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5" /></Style>
  </Application.Resources>
</Application>
